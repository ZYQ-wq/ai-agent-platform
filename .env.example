# ============================================================
# AI Agent Platform 环境变量示例
# ============================================================
#
# 本地开发：
#   cp .env.example server/.env
#   按实际情况填写后启动后端
#
# Docker 部署：
#   同样复制为 server/.env，docker-compose 会读取该文件
#
# 前端（可选，本地 web 目录下也可单独建 web/.env）：
#   VITE_API_BASE_URL 留空时，Docker 内由 Nginx 同源反代 API
# ============================================================

# ---------- 后端（server/.env）----------

# LLM（OpenAI 兼容接口，如阿里云 DashScope）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Agent 搜索工具（Tavily）
TAVILY_API_KEY=

# JWT 签名密钥（生产环境务必改为强随机字符串）
SECRET_KEY=change-me-in-production

# CORS 允许的前端来源，多个用英文逗号分隔
# 本地：http://localhost:5173
# Docker 反代：http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- 前端构建（web/.env 或 Docker build arg）----------

# API 基址。本地开发一般为：
# VITE_API_BASE_URL=http://localhost:8000
# Docker + Nginx 同源反代时可留空：
VITE_API_BASE_URL=
